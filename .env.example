POWERMEM_BACKEND=local_sdk
POWERMEM_STORAGE_PROVIDER=sqlite
POWERMEM_SQLITE_PATH=./data/powermem_smart_ev.db

# Any OpenAI-compatible endpoint works, e.g. DashScope compatible mode or https://api.openai.com/v1
LLM_PROVIDER=openai
LLM_MODEL=qwen-plus
LLM_API_KEY=REPLACE_ME
OPENAI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024
EMBEDDING_API_KEY=REPLACE_ME
OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_OPENAI_PASS_DIMENSIONS=false

SCENARIO_ID=smart_ev_cockpit
DEMO_PRIVACY_MODE=strict
