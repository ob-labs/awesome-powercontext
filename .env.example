POWERCONTEXT_BACKEND=builtin
POWERCONTEXT_SCOPE_ID=smart-ev-cockpit
POWERCONTEXT_DATABASE_URL=sqlite+aiosqlite:///data/powercontext_smart_ev.db
POWERCONTEXT_OPERATION_TIMEOUT_SECONDS=30

# To use OceanBase instead, provide one official async SQLAlchemy URL:
# POWERCONTEXT_DATABASE_URL=mysql+aoceanbase://user:password@127.0.0.1:2881/powercontext?charset=utf8mb4

# Optional: enables generated assistant replies. PowerContext Memory works without it.
# LLM_PROVIDER=openai
# LLM_MODEL=qwen-plus
# LLM_API_KEY=REPLACE_ME
# OPENAI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

SCENARIO_ID=smart_ev_cockpit
DEMO_PRIVACY_MODE=strict
